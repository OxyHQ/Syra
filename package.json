{
  "name": "syra",
  "version": "2.0.0",
  "license": "SEE LICENSE IN LICENSE",
  "description": "Syra Monorepo - Music Streaming App Frontend and Backend",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "bun@1.4.3",
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:frontend": "bun run --filter '@syra/frontend' dev",
    "dev:studio": "bun run --filter '@syra/studio' dev",
    "dev:backend": "bun run --filter '@syra/backend' dev",
    "build": "bun run --filter '*' build",
    "build:shared-types": "bun run --filter '@syra/shared-types' build",
    "build:sdk": "bun run --filter '@syra.fm/sdk' build",
    "build:frontend": "bun run --filter '@syra/frontend' build",
    "check:bundle-imports": "bun ./scripts/check-frontend-bundle-imports.mjs packages/frontend && bun ./scripts/check-frontend-bundle-imports.mjs packages/studio && bun ./scripts/test-check-frontend-bundle-imports.mjs",
    "check:web-bundle-budget": "bun ./scripts/check-web-export-budget.mjs",
    "test:performance-gates": "bun ./scripts/test-check-frontend-bundle-imports.mjs && bun ./scripts/test-check-web-export-budget.mjs",
    "build:studio": "bun run --filter '@syra/studio' build",
    "build:backend": "bun run --filter '@syra/backend' build",
    "test": "bun run --filter '*' test",
    "lint": "biome check . && bun run --filter '@syra/frontend' lint && bun run --filter '@syra/studio' lint",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "validate:ai-architecture": "bun ./scripts/validate-ai-architecture.mjs && bun ./scripts/test-validate-ai-architecture.mjs",
    "validate:agents-md": "bun ./scripts/check-agents-md-size.mjs && bun ./scripts/test-check-agents-md-size.mjs",
    "check:bun-pin": "bun ./scripts/check-bun-pin.mjs && bun ./scripts/test-check-bun-pin.mjs",
    "doctor:oxy": "oxy-doctor --ci",
    "clean": "bun run --filter '*' clean && rm -rf node_modules",
    "install:all": "bun install",
    "start:frontend": "bun run --filter '@syra/frontend' start",
    "start:studio": "bun run --filter '@syra/studio' start",
    "start:backend": "bun run --filter '@syra/backend' start",
    "postinstall": "bun run build:contracts && bun run --filter '@syra/shared-types' build",
    "build:contracts": "bun run --cwd packages/contracts build",
    "check:public-openapi": "bun scripts/check-public-openapi.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@oxy.so/doctor": "1.2.0",
    "@types/node": "^20.0.0",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "@oxy.so/bloom": "15.0.0",
    "@oxy.so/core": "6.14.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-css": "3.1.0-rc.0",
    "nativewind": "5.0.0-preview.3",
    "tailwindcss": "4.2.2",
    "lightningcss": "1.30.1",
    "lightningcss-linux-x64-gnu": "1.30.1",
    "@oxy.so/services": "12.12.0",
    "@oxy.so/contracts": "5.7.0",
    "@oxy.so/protocol": "1.4.1"
  }
}
