    "@gorhom/bottom-sheet": "^5.2.6",
    "@livekit/react-native": "^2.11.1",
    "@oxy.so/app-preset": "^3.3.0",
    "@oxy.so/bloom": "14.0.0",
    "@oxy.so/core": "6.0.0",
    "@oxy.so/services": "^12.2.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/flash-list": "2.3.2",
    "@syra.fm/sdk": "workspace:*",
    "@syra/shared-types": "workspace:*",
    "@tanstack/query-async-storage-persister": "^5.101.2",
    "@tanstack/query-sync-storage-persister": "^5.101.2",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-query-persist-client": "^5.101.2",
    "axios": "^1.18.1",
