{
  "name": "@syra/frontend",
  "main": "expo-router/entry",
  "version": "2.0.0",
  "scripts": {
    "start": "RCT_METRO_PORT=8120 expo start --reset-cache --tunnel --clear",
    "start:local": "RCT_METRO_PORT=8120 expo start --reset-cache --clear",
    "dev": "RCT_METRO_PORT=8120 expo start --reset-cache --tunnel --clear",
    "dev:local": "RCT_METRO_PORT=8120 expo start --reset-cache --clear",
    "reset-project": "bun ./scripts/reset-project.js",
    "clear-cache": "bun ./scripts/clear-cache.js",
    "android": "RCT_METRO_PORT=8120 expo run:android",
    "ios": "RCT_METRO_PORT=8120 expo run:ios",
    "web": "RCT_METRO_PORT=8120 expo start --web",
    "build": "expo export --platform web --source-maps --output-dir dist && bun ./scripts/remove-css-preloads.mjs && bun ../../scripts/write-web-bundle-inventory.mjs dist .expo/web-bundle-inventory.json",
    "build-web": "expo export --platform web --source-maps --output-dir dist && bun ./scripts/remove-css-preloads.mjs && bun ../../scripts/write-web-bundle-inventory.mjs dist .expo/web-bundle-inventory.json",
    "build-web:prod": "expo export --platform web --source-maps --output-dir dist && bun ./scripts/remove-css-preloads.mjs && bun ../../scripts/write-web-bundle-inventory.mjs dist .expo/web-bundle-inventory.json",
    "test": "jest --watchAll=false",
    "typecheck": "tsc --noEmit",
    "check-i18n": "bun ./scripts/check-i18n.mjs",
    "lint": "expo lint",
    "clean": "rm -rf dist .expo",
    "analyze-bundle": "bun ./scripts/analyze-bundle.js"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1",
      "^@oxy.so/core$": "<rootDir>/../../node_modules/@oxy.so/core/dist/cjs/index.js",
      "^@oxy.so/protocol/(.*)$": "<rootDir>/../../node_modules/@oxy.so/protocol/dist/cjs/$1.js",
      "^@oxy.so/protocol$": "<rootDir>/../../node_modules/@oxy.so/protocol/dist/cjs/index.js",
      "^@oxy.so/contracts/client$": "<rootDir>/../../node_modules/@oxy.so/contracts/dist/cjs/client/index.js",
      "^@oxy.so/contracts$": "<rootDir>/../../node_modules/@oxy.so/contracts/dist/cjs/index.js"
    }
  },
  "dependencies": {
    "@alia.onl/sdk": "22.1.1",
    "@bitdrift/react-native": "^0.8.0",
    "@expo/app-integrity": "~58.0.2",
    "@expo/vector-icons": "^15.0.2",
    "@gorhom/bottom-sheet": "^5.2.6",
