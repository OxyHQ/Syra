    "eslint-plugin-react-hooks": "^7.1.1",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.12",
    "react-test-renderer": "19.3.0",
    "typescript": "~6.0.3",
    "wrangler": "3.114.17",
    "socket.io": "^4.8.3"
  },
  "private": true,
  "optionalDependencies": {
