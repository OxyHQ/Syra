# The service worker files must revalidate on every load: the syra.fm zone
# otherwise gives .js responses a 4-hour browser TTL, which would hold a new
# deploy's worker back. oxy-web-pwa (@oxy.so/app-preset) writes these files.
/sw.js
  Cache-Control: no-cache
/oxy-sw-base.js
  Cache-Control: no-cache
/oxy-sw-register.js
  Cache-Control: no-cache

# Content-hashed: every file the Expo export writes under /_expo/static/ is named
# by a hash of its bytes, so a browser keeps it for a year and never revalidates.
# Without this rule the zone's 4-hour browser TTL made every return visit after
# that re-ask for each one. Entry files (index.html, public/) are not here.
#
# A hashed name this deploy lacks (an old tab asking for the last release's
# chunk) is a real 404 (`no-store`), never index.html kept for a year:
# scripts/write-hashed-asset-404.mjs writes `_expo/static/404.html` after the
# export, and Pages answers a miss with the closest 404.html.
/_expo/static/*
  Cache-Control: public, max-age=31536000, immutable
