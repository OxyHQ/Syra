{
  "name": "@syra/shared-types",
  "version": "1.0.0",
  "private": true,
  "description": "Shared TypeScript types for Syra frontend and backend",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "bun test src",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "typescript",
    "types",
    "shared",
    "syra"
  ],
  "author": "Syra Team",
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "typescript": "~5.9.2",
    "@types/node": "^20.0.0"
  },
  "files": [
    "dist/**/*"
  ]
}
