{
  "name": "@syra/backend",
  "version": "1.0.0",
  "private": true,
  "author": "",
  "type": "commonjs",
  "main": "server.ts",
  "scripts": {
    "start": "bun server.ts",
    "dev": "bun --watch server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "bun check",
    "backfill:track-audio-keys": "bun src/scripts/backfillTrackAudioKeys.ts",
    "backfill:fingerprints": "bun src/scripts/backfillTrackFingerprints.ts",
    "backfill:episode-images": "bun src/scripts/backfillEpisodeImages.ts",
    "backfill:podcast-covers": "bun src/scripts/backfillPodcastCovers.ts",
    "migrate:images-to-oxy": "bun src/scripts/migrateImagesToOxy.ts",
    "migrate:alia-covers": "bun src/scripts/migrateAliaCovers.ts",
    "retire:legacy-image-storage": "bun src/scripts/retireLegacyImageStorage.ts",
    "migrate:audio-to-oxy": "bun src/scripts/migrateAudioToOxy.ts",
    "retire:legacy-audio-ladders": "bun src/scripts/retireLegacyAudioLadders.ts",
    "reseed:persons": "bun src/scripts/reseedPersons.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:check-locks": "oxy-db-check-migration-locks --migrations=drizzle --after=36 --hot-tables=catalog_entities,tracks,albums,playlists,podcasts,episodes,track_keys,track_hls_renditions",
    "test": "rm -rf dist && bun test src",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1087.0",
    "@aws-sdk/s3-request-presigner": "^3.1087.0",
    "@crowdsource.you/contracts": "1.1.0",
    "@crowdsource.you/core": "3.0.2",
    "@oxy.so/core": "5.2.0",
    "@oxy.so/db": "^1.3.0",
    "@oxy.so/utils": "1.2.0",
    "@socket.io/redis-adapter": "^8.2.0",
    "@syra.fm/contracts": "workspace:*",
    "@syra.fm/sdk": "workspace:*",
    "@syra/shared-types": "workspace:*",
    "@types/compression": "^1.8.1",
    "@types/multer": "^2.2.0",
    "@types/sharp": "^0.32.0",
    "body-parser": "^2.3.0",
    "bullmq": "^6.0.4",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "drizzle-orm": "0.45.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.0.1",
    "express-slow-down": "^3.1.0",
    "express-validator": "^7.0.1",
    "fast-xml-parser": "^5.10.0",
    "firebase-admin": "^14.1.0",
    "i18n": "^0.15.1",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "jwt-decode": "^4.0.0",
    "livekit-server-sdk": "^2.17.0",
    "multer": "^2.1.1",
    "music-metadata": "^11.14.0",
    "node-telegram-bot-api": "^1.2.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "postgres": "3.4.9",
    "qrcode-terminal": "^0.12.0",
    "redis": "^6.1.0",
    "sharp": "^0.35.3",
    "socket.io": "^4.8.1",
    "url-metadata": "^5.7.4",
    "validator": "^13.15.22",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "drizzle-kit": "0.31.10",
    "typescript": "~5.9.2"
  }
}
